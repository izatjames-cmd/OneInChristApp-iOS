{
  "appId": "org.oneinchristchurch.app",
  "appName": "One in Christ Church",
  "webDir": "dist",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": []
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          },
          "@capacitor-firebase/firestore": {
            "symlink": true
          },
          "@capacitor-firebase/functions": {
            "symlink": true
          },
          "@capacitor-firebase/storage": {
            "symlink": true
          },
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
